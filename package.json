{
  "name": "gasyori100knockjs",
  "version": "1.0.0",
  "private": true,
  "description": "画像処理100本ノックを TypeScript + Canvas API で解く",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s-yoshiki/Gasyori100knockJS.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:registry": "tsx scripts/gen-registry.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "fix": "pnpm lint:fix && pnpm format",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "verify": "pnpm check && pnpm build"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "packageManager": "pnpm@12.20.0"
}
